FROM node:22-bookworm-slim
RUN apt-get -o Acquire::http::Proxy="$HTTP_PROXY" -o Acquire::https::Proxy="$HTTPS_PROXY" update \
    && apt-get -o Acquire::http::Proxy="$HTTP_PROXY" -o Acquire::https::Proxy="$HTTPS_PROXY" install -y --no-install-recommends chromium fonts-noto-cjk ca-certificates libnss3-tools \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /var/lib/remote-dom && chown node:node /var/lib/remote-dom
USER node
WORKDIR /app
ENV CHROMIUM_PATH=/usr/bin/chromium
ENV DEVICE_PROFILE_DIR=/var/lib/remote-dom
ENV XDG_CONFIG_HOME=/tmp/remote-dom-config XDG_CACHE_HOME=/tmp/remote-dom-cache
